# Server-only secret. Never use a VITE_ prefix for the API key.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
# Set true only when building for the included Node server, not GitHub Pages.
VITE_ENABLE_GEMINI=false

# Classroom server (do not enable without setting server-only secrets)
CLASSROOM_ENABLED=false
CLASSROOM_DB_PATH=data/classroom.sqlite
ADMIN_LOGIN=instructor
ADMIN_PASSWORD=
CLASSROOM_JOIN_CODE=
# Public HTTPS classroom URL only; no secrets
VITE_CLASSROOM_URL=

# Free Render Postgres: server-only internal connection string
DATABASE_URL=
CLASSROOM_STORAGE_NOTICE=
CLASSROOM_EXPIRES_AT=
